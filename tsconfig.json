{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stellar-escrow/sdk": ["sdk/src/index.ts"]
    },
    "rootDir": "."
  },
  "include": [
    "sdk/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "examples/**/*.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "frontend"]
}
